@page "/products"
@inherits AbpComponentBase
@using EcommercePlatform.Application.Services
@using EcommercePlatform.Enums
@using Volo.Abp.Application.Dtos
@inject IProductAppService ProductAppService
@inject ICategoryAppService CategoryAppService
@inject NavigationManager NavigationManager

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Products</h1>
            <p class="text-muted">Manage your product catalog</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search products..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? OnSearch() : null)">
                <button class="btn btn-outline-primary" type="button" @onclick="OnSearch">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="@(e => OnCategoryChanged(e.Value.ToString() == "all" ? null : Guid.Parse(e.Value.ToString())))">
                <option value="all">All Categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-5 text-end">
            <button class="btn btn-primary" @onclick="NavigateToCreateProduct">
                <i class="fas fa-plus"></i> Add New Product
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40px">#</th>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("Name"))">
                                        Name
                                        @if (SortField == "Name")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("BasePrice"))">
                                        Price
                                        @if (SortField == "BasePrice")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th>Type</th>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("StockQuantity"))">
                                        Stock
                                        @if (SortField == "StockQuantity")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th>Status</th>
                                    <th style="width: 200px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Products.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="fas fa-box fa-2x mb-2"></i>
                                                <p>No products found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var product in Products)
                                    {
                                        <tr>
                                            <td>@((CurrentPage - 1) * PageSize + Products.IndexOf(product) + 1)</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="ms-2">
                                                        <h6 class="mb-0">@product.Name</h6>
                                                        <small class="text-muted">SKU: @product.Sku</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div @onclick:stopPropagation>
                                                    @((MarkupString)GetPriceDisplay(product.BasePrice, product.DynamicPrice))
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@GetProductTypeLabel(product.ProductType)</span>
                                            </td>
                                            <td>
                                                @if (product.StockQuantity <= 0)
                                                {
                                                    <span class="badge bg-danger">Out of stock</span>
                                                }
                                                else if (product.StockQuantity < 10)
                                                {
                                                    <span class="badge bg-warning text-dark">Low stock (@product.StockQuantity)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">In stock (@product.StockQuantity)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (product.IsPublished)
                                                {
                                                    <span class="badge bg-success">Published</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Draft</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToProductDetail(product.Id)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    @if (product.IsPublished)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => UnpublishProduct(product.Id)">
                                                            <i class="fas fa-eye-slash"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => PublishProduct(product.Id)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProduct(product.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <span class="text-muted">Showing @((CurrentPage - 1) * PageSize + 1) to @(Math.Min(CurrentPage * PageSize, TotalCount)) of @TotalCount entries</span>
                        </div>
                        <div class="col-md-6">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-end mb-0">
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(CurrentPage - 1)" tabindex="-1">Previous</a>
                                    </li>
                                    @{
                                        var totalPages = (int)Math.Ceiling(TotalCount / (double)PageSize);
                                        var startPage = Math.Max(1, CurrentPage - 2);
                                        var endPage = Math.Min(totalPages, startPage + 4);
                                        
                                        if (startPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(1)">1</a>
                                            </li>
                                            if (startPage > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <a class="page-link" href="javascript:void(0)">...</a>
                                                </li>
                                            }
                                        }
                                        
                                        for (var i = startPage; i <= endPage; i++)
                                        {
                                            var pageNumber = i;
                                            <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(pageNumber)">@pageNumber</a>
                                            </li>
                                        }
                                        
                                        if (endPage < totalPages)
                                        {
                                            if (endPage < totalPages - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <a class="page-link" href="javascript:void(0)">...</a>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(totalPages)">@totalPages</a>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(CurrentPage == (int)Math.Ceiling(TotalCount / (double)PageSize) ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(CurrentPage + 1)">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
