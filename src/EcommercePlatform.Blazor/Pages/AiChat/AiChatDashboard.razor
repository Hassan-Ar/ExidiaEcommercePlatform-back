@page "/ai-chat"
@inherits AbpComponentBase
@using EcommercePlatform.Application.Services
@inject IAiChatAppService AiChatAppService
@inject NavigationManager NavigationManager

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>AI Shopping Assistant</h1>
            <p class="text-muted">Get personalized shopping assistance and product recommendations</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Chat Sessions</h5>
                    <button class="btn btn-sm btn-primary" @onclick="CreateNewSessionAsync">
                        <i class="fas fa-plus"></i> New Chat
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (ActiveSessions.Count == 0)
                        {
                            <div class="list-group-item text-center py-4">
                                <div class="text-muted">
                                    <i class="fas fa-comments fa-2x mb-2"></i>
                                    <p>No active sessions</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var session in ActiveSessions)
                            {
                                <a href="javascript:void(0)" 
                                   class="list-group-item list-group-item-action @(session.Id == CurrentSessionId ? "active" : "")"
                                   @onclick="() => SelectSessionAsync(session.Id)">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">Session #@session.Id.ToString().Substring(0, 8)</h6>
                                        <small>@session.LastActivityTime.ToString("HH:mm")</small>
                                    </div>
                                    <small>@(session.Messages.Count) messages</small>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">AI Capabilities</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-search text-primary me-2"></i> Product search and discovery
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-tag text-primary me-2"></i> Personalized recommendations
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-question-circle text-primary me-2"></i> Product information
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-truck text-primary me-2"></i> Order status inquiries
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-undo text-primary me-2"></i> Return assistance
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @if (CurrentSessionId.HasValue)
                        {
                            <span>Chat #@CurrentSessionId.Value.ToString().Substring(0, 8)</span>
                        }
                        else
                        {
                            <span>New Chat</span>
                        }
                    </h5>
                    <button class="btn btn-sm btn-outline-danger" @onclick="EndSessionAsync">
                        <i class="fas fa-times"></i> End Chat
                    </button>
                </div>
                <div class="card-body chat-container" style="height: 500px; overflow-y: auto;">
                    @if (CurrentSessionMessages.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="fas fa-robot fa-3x mb-3"></i>
                                <p>Start a conversation with the AI shopping assistant</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="chat-messages">
                            @foreach (var message in CurrentSessionMessages)
                            {
                                <div class="message @GetMessageClass(message.IsFromUser)">
                                    <div class="message-content">
                                        <div class="message-text">@message.Content</div>
                                        <div class="message-time">@GetFormattedTime(message.CreationTime)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Type your message..." 
                               @bind="NewMessage" @bind:event="oninput" 
                               @onkeyup="@(e => e.Key == "Enter" ? SendMessageAsync() : null)" 
                               disabled="@IsProcessing" />
                        <button class="btn btn-primary" type="button" @onclick="SendMessageAsync" disabled="@IsProcessing">
                            @if (IsProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="fas fa-paper-plane"></i>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-messages {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .message {
        display: flex;
        max-width: 80%;
    }

    .user-message {
        align-self: flex-end;
    }

    .ai-message {
        align-self: flex-start;
    }

    .message-content {
        padding: 10px 15px;
        border-radius: 18px;
        position: relative;
    }

    .user-message .message-content {
        background-color: #007bff;
        color: white;
        border-bottom-right-radius: 5px;
    }

    .ai-message .message-content {
        background-color: #f0f2f5;
        color: #333;
        border-bottom-left-radius: 5px;
    }

    .message-time {
        font-size: 0.7rem;
        opacity: 0.7;
        margin-top: 5px;
        text-align: right;
    }

    .user-message .message-time {
        color: rgba(255, 255, 255, 0.8);
    }
</style>
