@page "/orders"
@inherits AbpComponentBase
@using EcommercePlatform.Application.Services
@using EcommercePlatform.Enums
@using Volo.Abp.Application.Dtos
@inject IOrderAppService OrderAppService
@inject NavigationManager NavigationManager

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Orders</h1>
            <p class="text-muted">Manage customer orders</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search order #..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? OnSearch() : null)">
                <button class="btn btn-outline-primary" type="button" @onclick="OnSearch">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-2">
            <select class="form-select" @onchange="@(e => OnStatusFilterChanged(e.Value.ToString() == "all" ? null : Enum.Parse<OrderStatus>(e.Value.ToString())))">
                <option value="all">All Statuses</option>
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@status">@GetOrderStatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @onchange="@(e => OnPaymentStatusFilterChanged(e.Value.ToString() == "all" ? null : Enum.Parse<PaymentStatus>(e.Value.ToString())))">
                <option value="all">All Payment Statuses</option>
                @foreach (PaymentStatus status in Enum.GetValues(typeof(PaymentStatus)))
                {
                    <option value="@status">@GetPaymentStatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" class="form-control" @bind="StartDate" @onchange="OnDateFilterChanged" placeholder="Start Date" />
        </div>
        <div class="col-md-2">
            <input type="date" class="form-control" @bind="EndDate" @onchange="OnDateFilterChanged" placeholder="End Date" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-outline-secondary w-100" @onclick="@(() => { StartDate = null; EndDate = null; OnDateFilterChanged(); })">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("OrderNumber"))">
                                        Order #
                                        @if (SortField == "OrderNumber")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("CreationTime"))">
                                        Date
                                        @if (SortField == "CreationTime")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th>Customer</th>
                                    <th style="cursor: pointer" @onclick="@(() => OnSortChanged("TotalAmount"))">
                                        Total
                                        @if (SortField == "TotalAmount")
                                        {
                                            <i class="fas @(SortAscending ? "fa-sort-up" : "fa-sort-down")"></i>
                                        }
                                    </th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th style="width: 200px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Orders.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                                                <p>No orders found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var order in Orders)
                                    {
                                        <tr style="cursor: pointer" @onclick="() => NavigateToOrderDetail(order.Id)">
                                            <td>
                                                <strong>@order.OrderNumber</strong>
                                            </td>
                                            <td>
                                                @order.CreationTime.ToString("MMM dd, yyyy HH:mm")
                                            </td>
                                            <td>
                                                <span>@order.CustomerId.ToString().Substring(0, 8)...</span>
                                            </td>
                                            <td>
                                                <strong>$@order.TotalAmount.ToString("F2")</strong>
                                            </td>
                                            <td>
                                                <span class="badge @GetOrderStatusClass(order.Status)">@GetOrderStatusLabel(order.Status)</span>
                                            </td>
                                            <td>
                                                <span class="badge @GetPaymentStatusClass(order.PaymentStatus)">@GetPaymentStatusLabel(order.PaymentStatus)</span>
                                            </td>
                                            <td @onclick:stopPropagation>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="dropdownMenuButton@(order.Id)" data-bs-toggle="dropdown" aria-expanded="false">
                                                        Actions
                                                    </button>
                                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton@(order.Id)">
                                                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => NavigateToOrderDetail(order.Id)">View Details</a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        
                                                        @if (order.Status == OrderStatus.Pending)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => UpdateOrderStatus(order.Id, OrderStatus.Processing)">Mark as Processing</a></li>
                                                        }
                                                        
                                                        @if (order.Status == OrderStatus.Processing)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => MarkAsShipped(order.Id)">Mark as Shipped</a></li>
                                                        }
                                                        
                                                        @if (order.Status == OrderStatus.Shipped)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => MarkAsDelivered(order.Id)">Mark as Delivered</a></li>
                                                        }
                                                        
                                                        @if (order.Status == OrderStatus.Delivered)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => MarkAsCompleted(order.Id)">Mark as Completed</a></li>
                                                        }
                                                        
                                                        @if (order.PaymentStatus == PaymentStatus.Pending)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => UpdatePaymentStatus(order.Id, PaymentStatus.Paid)">Mark as Paid</a></li>
                                                        }
                                                        
                                                        @if (order.Status != OrderStatus.Cancelled && order.Status != OrderStatus.Completed && order.Status != OrderStatus.Refunded)
                                                        {
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li><a class="dropdown-item text-danger" href="javascript:void(0)" @onclick="() => CancelOrder(order.Id)">Cancel Order</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <span class="text-muted">Showing @((CurrentPage - 1) * PageSize + 1) to @(Math.Min(CurrentPage * PageSize, TotalCount)) of @TotalCount entries</span>
                        </div>
                        <div class="col-md-6">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-end mb-0">
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(CurrentPage - 1)" tabindex="-1">Previous</a>
                                    </li>
                                    @{
                                        var totalPages = (int)Math.Ceiling(TotalCount / (double)PageSize);
                                        var startPage = Math.Max(1, CurrentPage - 2);
                                        var endPage = Math.Min(totalPages, startPage + 4);
                                        
                                        if (startPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(1)">1</a>
                                            </li>
                                            if (startPage > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <a class="page-link" href="javascript:void(0)">...</a>
                                                </li>
                                            }
                                        }
                                        
                                        for (var i = startPage; i <= endPage; i++)
                                        {
                                            var pageNumber = i;
                                            <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(pageNumber)">@pageNumber</a>
                                            </li>
                                        }
                                        
                                        if (endPage < totalPages)
                                        {
                                            if (endPage < totalPages - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <a class="page-link" href="javascript:void(0)">...</a>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(totalPages)">@totalPages</a>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(CurrentPage == (int)Math.Ceiling(TotalCount / (double)PageSize) ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="() => OnPageChanged(CurrentPage + 1)">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
